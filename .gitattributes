# Handle line endings automatically
* text=auto

# Explicitly set all R and text files to LF on commit
*.R text eol=lf
*.Rmd text eol=lf
*.qmd text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.gitignore text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.RData binary